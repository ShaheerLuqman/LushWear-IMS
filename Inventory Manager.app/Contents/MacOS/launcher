#!/usr/bin/env bash
# Silent launcher for Inventory Manager on macOS.
# Invoked by LaunchServices when the user double-clicks the .app; no Terminal window is opened.
# stdout/stderr go to a log file so failures are diagnosable.

LOG_DIR="$HOME/Library/Logs/InventoryManager"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/launcher.log"

exec >>"$LOG_FILE" 2>&1
echo
echo "===== $(date) ====="

# Show an alert and exit. Always reachable from anywhere in the script.
fail() {
    local msg="$1"
    echo "FAIL: $msg"
    /usr/bin/osascript -e "display alert \"Inventory Manager\" message \"$msg\n\nSee log: $LOG_FILE\" as critical" >/dev/null 2>&1 || true
    exit 1
}

# Find the .app bundle location.
BUNDLE_DIR="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)" || fail "Cannot resolve bundle directory."
echo "Bundle: $BUNDLE_DIR"

# Locate the inventory-system repo. Try, in order:
#   1) Sibling to the .app (the usual case: .app sits inside the repo).
#   2) ~/inventory-system, ~/Amad/inventory-system, ~/Documents/inventory-system, ~/Developer/inventory-system.
#   3) An override path stored in ~/.config/inventory-manager/repo-path.
find_repo() {
    local candidate
    # 1) Parent of the .app
    candidate="$(cd "$BUNDLE_DIR/.." 2>/dev/null && pwd)" || true
    if [ -n "$candidate" ] && [ -f "$candidate/start-app.command" ] && [ -d "$candidate/frontend" ]; then
        echo "$candidate"
        return 0
    fi
    # 2) Common locations
    for p in \
        "$HOME/inventory-system" \
        "$HOME/Amad/inventory-system" \
        "$HOME/Documents/inventory-system" \
        "$HOME/Developer/inventory-system" \
        "$HOME/Projects/inventory-system" \
        "$HOME/Desktop/inventory-system"
    do
        if [ -f "$p/start-app.command" ] && [ -d "$p/frontend" ]; then
            echo "$p"
            return 0
        fi
    done
    # 3) Override
    if [ -f "$HOME/.config/inventory-manager/repo-path" ]; then
        candidate="$(cat "$HOME/.config/inventory-manager/repo-path")"
        if [ -f "$candidate/start-app.command" ] && [ -d "$candidate/frontend" ]; then
            echo "$candidate"
            return 0
        fi
    fi
    return 1
}

REPO_DIR="$(find_repo)" || REPO_DIR=""
if [ -z "$REPO_DIR" ]; then
    fail "Cannot find the inventory-system repo. Searched next to the .app and in common locations under \$HOME. To fix, create the file ~/.config/inventory-manager/repo-path containing the full path to your inventory-system folder."
fi
echo "Repo: $REPO_DIR"

cd "$REPO_DIR" || fail "Failed to cd into $REPO_DIR"

# GUI-launched .app bundles get a minimal PATH from LaunchServices — typically just
# /usr/bin:/bin:/usr/sbin:/sbin — so node, npm, brew, nvm, etc. are invisible even
# though they work fine in Terminal. Fix PATH BEFORE running any tool checks.
#
# Strategy: start with the common static locations, then ask the user's interactive
# login shell (zsh on macOS 10.15+) for its real PATH and merge it in. That captures
# nvm, Volta, asdf, Homebrew on Apple Silicon, and custom rc-file PATH additions.
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Pull PATH from the user's login shell. -l -i sources login + interactive rc files
# (.zprofile, .zshrc, .bash_profile, .bashrc). Suppress stderr so rc-file noise
# (e.g., welcome banners) doesn't pollute the log.
LOGIN_SHELL="${SHELL:-/bin/zsh}"
SHELL_PATH="$("$LOGIN_SHELL" -l -i -c 'printf %s "$PATH"' 2>/dev/null || true)"
if [ -n "$SHELL_PATH" ]; then
    export PATH="$SHELL_PATH:$PATH"
    echo "Merged login-shell PATH"
fi
echo "PATH=$PATH"

# Sanity checks for required tools (now that PATH is correct).
command -v python3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1 || \
    fail "Python is not installed, or not on the login-shell PATH. Install Python 3 from python.org. Resolved PATH:\n$PATH"
command -v npm >/dev/null 2>&1 || \
    fail "Node.js/npm is not installed, or not on the login-shell PATH. \`which npm\` in Terminal: $(/usr/bin/which npm 2>/dev/null || echo not-found). Resolved PATH:\n$PATH"

echo "node: $(command -v node) ($(node --version 2>/dev/null || echo unknown))"
echo "npm: $(command -v npm) ($(npm --version 2>/dev/null || echo unknown))"
echo "python: $(command -v python3 || command -v python)"

# Make sure start-app.command is executable. Git stores +x, but a zip download won't.
if [ ! -x "$REPO_DIR/start-app.command" ]; then
    echo "start-app.command is not executable, chmod +x"
    chmod +x "$REPO_DIR/start-app.command" 2>/dev/null || true
fi

# Strip quarantine on the .app and the start script if Gatekeeper added it.
/usr/bin/xattr -dr com.apple.quarantine "$BUNDLE_DIR" 2>/dev/null || true
/usr/bin/xattr -d com.apple.quarantine "$REPO_DIR/start-app.command" 2>/dev/null || true

# Kill anything still bound to the backend port from a prior crashed run.
cleanup_port() {
    local pids
    pids="$(lsof -ti:8000 2>/dev/null || true)"
    if [ -n "$pids" ]; then
        echo "Cleaning up port 8000 PIDs: $pids"
        kill -9 $pids 2>/dev/null || true
    fi
}

# Only clean up on EXIT, not on INT/TERM — Electron handles its own shutdown.
trap 'echo "Launcher exit trap, cleaning up port 8000..."; cleanup_port' EXIT

cleanup_port

export SHOW_TERMINALS=0

# The Python interpreter baked into the venv may not match the one .app sees.
# If venv exists, sanity-check it works under the current PATH/env; if not, rebuild.
VENV_PYTHON="$REPO_DIR/backend/venv/bin/python"
if [ -x "$VENV_PYTHON" ]; then
    echo "venv python: $VENV_PYTHON"
    if ! "$VENV_PYTHON" -c "import sys; print('venv ok, version:', sys.version)" 2>&1; then
        echo "venv python is broken in this environment — removing so start-app.command recreates it"
        rm -rf "$REPO_DIR/backend/venv"
    elif ! "$VENV_PYTHON" -c "import uvicorn, fastapi" 2>&1; then
        echo "venv missing uvicorn/fastapi — letting start-app.command reinstall"
    fi
fi

echo "Running start-app.command..."
# Tee Electron's stdout/stderr (which includes piped backend output) to a log file.
ELECTRON_LOG="$LOG_DIR/electron.log"
echo "(electron+backend output below also tee'd from start-app.command)"
bash "$REPO_DIR/start-app.command" 2>&1 | tee -a "$ELECTRON_LOG"
EXIT_CODE=${PIPESTATUS[0]}
echo "start-app.command exited with code $EXIT_CODE"

if [ $EXIT_CODE -ne 0 ]; then
    fail "Startup failed with code $EXIT_CODE. Open Terminal and run \\\"bash '$REPO_DIR/start-app.command'\\\" to see what went wrong."
fi

exit 0
